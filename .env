# Local development environment for KitchenOS.
# This file is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=3000

# MySQL provided by the bundled docker-compose.yml (`docker compose up -d`).
DATABASE_URL=mysql://kitchenos:kitchenos@127.0.0.1:3306/kitchenos

# Session signing secret (32+ characters). Generate a fresh one for any
# non-local deployment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=50c7984ba6de86578800efce145bc8beeb3e097d2440656bd4528ecf1a585bdb45cb6121e66903f0729ebf47040d31a7

# --- Optional integrations: features degrade gracefully when unset. ---

# AI ingredient parsing (any OpenAI-compatible endpoint)
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1

# Generic OAuth sign-in (leave unset to use the local test login)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTHORIZATION_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_CALLBACK_URL=
# OAUTH_SCOPES=openid email profile

# Manus-style managed object storage for recipe photos
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
